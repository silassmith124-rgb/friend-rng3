<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Friend RNG</title>

<style>
*{
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

body{
    margin:0;
    min-height:100vh;
    font-family:Arial,sans-serif;
    color:white;
    background:
        radial-gradient(circle at 15% 5%,#581c87 0%,transparent 28%),
        radial-gradient(circle at 90% 15%,#164e63 0%,transparent 28%),
        linear-gradient(145deg,#020617,#0f172a 55%,#111827);
}

button{
    border:0;
    border-radius:14px;
    padding:12px 15px;
    color:white;
    font-weight:900;
    cursor:pointer;
    transition:.15s;
}

button:active{
    transform:scale(.96);
}

button:disabled{
    opacity:.45;
    cursor:not-allowed;
}

header{
    text-align:center;
    padding:25px 12px 20px;
    background:rgba(2,6,23,.94);
    border-bottom:1px solid #334155;
    position:sticky;
    top:0;
    z-index:20;
}

.logo{
    font-size:31px;
    font-weight:1000;
    letter-spacing:2px;
}

.subtitle{
    color:#94a3b8;
    font-size:12px;
    margin-top:6px;
}

.container{
    width:94%;
    max-width:780px;
    margin:auto;
    padding:15px 0 60px;
}

.tabs{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:6px;
    margin-bottom:15px;
}

.tab{
    background:#1e293b;
    color:#94a3b8;
}

.tab.active{
    background:linear-gradient(135deg,#8b5cf6,#4f46e5);
    color:white;
    box-shadow:0 5px 20px rgba(99,102,241,.35);
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.card{
    background:rgba(30,41,59,.94);
    border:1px solid rgba(255,255,255,.08);
    border-radius:21px;
    padding:18px;
    margin-bottom:15px;
    box-shadow:0 14px 35px rgba(0,0,0,.25);
}

h2{
    margin-top:0;
}

.small{
    color:#94a3b8;
    font-size:13px;
    line-height:1.5;
}

.message{
    min-height:25px;
    text-align:center;
    color:#facc15;
    font-weight:900;
    margin:8px;
}

/* RESULT */

.result{
    height:260px;
    border-radius:28px;
    background:radial-gradient(circle,#1e293b,#020617 75%);
    border:1px solid #334155;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    text-align:center;
    overflow:hidden;
    position:relative;
}

.resultGlow{
    position:absolute;
    width:260px;
    height:260px;
    border-radius:50%;
    background:rgba(99,102,241,.15);
    filter:blur(45px);
}

#auraName{
    position:relative;
    z-index:2;
    font-size:42px;
    font-weight:1000;
}

#auraChance{
    position:relative;
    z-index:2;
    color:#94a3b8;
    margin-top:8px;
}

#spinButton{
    width:100%;
    margin:14px 0;
    padding:19px;
    font-size:23px;
    background:linear-gradient(135deg,#8b5cf6,#6366f1);
    box-shadow:0 9px 30px rgba(99,102,241,.35);
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:7px;
}

.stat{
    background:#334155;
    border-radius:14px;
    padding:13px 5px;
    text-align:center;
}

.statNumber{
    font-size:21px;
    font-weight:1000;
}

.statLabel{
    font-size:10px;
    color:#94a3b8;
    margin-top:3px;
}

/* POTIONS */

.potion{
    width:100%;
    margin:5px 0;
}

.luck{
    background:linear-gradient(135deg,#16a34a,#22c55e);
}

.speed{
    background:linear-gradient(135deg,#0284c7,#06b6d4);
}

/* INVENTORY */

.inventoryItem,
.indexItem{
    display:grid;
    grid-template-columns:1fr auto auto;
    align-items:center;
    gap:8px;
    background:#334155;
    border-radius:12px;
    padding:11px;
    margin:6px 0;
}

.auraText{
    font-weight:900;
}

.chance{
    color:#94a3b8;
    font-size:12px;
}

.delete{
    background:#ef4444;
    padding:7px 9px;
    font-size:11px;
}

.empty{
    color:#64748b;
    text-align:center;
    padding:25px;
}

/* AUTO DELETE */

.autoItem{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:9px;
    border-bottom:1px solid #334155;
}

.autoItem:last-child{
    border-bottom:0;
}

.autoButton{
    background:#475569;
    font-size:10px;
    padding:7px;
}

.autoButton.active{
    background:#dc2626;
}

/* GADGETS */

.gadget{
    border-radius:20px;
    padding:17px;
    margin-bottom:15px;
    background:linear-gradient(145deg,#172033,#0f172a);
    border:1px solid #475569;
    position:relative;
    overflow:hidden;
}

.gadgetTop{
    display:flex;
    align-items:center;
    gap:13px;
}

.gadgetIcon{
    width:64px;
    height:64px;
    flex-shrink:0;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
    background:linear-gradient(135deg,#0891b2,#1d4ed8);
}

.calebGadget{
    border-color:#f59e0b;
}

.calebIcon{
    background:linear-gradient(135deg,#f59e0b,#dc2626);
}

.freshGadget{
    border-color:#db2777;
}

.freshIcon{
    background:linear-gradient(135deg,#ec4899,#7c3aed);
}

.gadgetName{
    font-size:19px;
    font-weight:1000;
}

.gadgetEffect{
    color:#cbd5e1;
    font-size:13px;
    margin-top:3px;
}

.material{
    display:inline-block;
    padding:6px 8px;
    margin:3px;
    border-radius:9px;
    background:#334155;
    font-size:12px;
}

.craftButton{
    width:100%;
    margin-top:10px;
    background:linear-gradient(135deg,#7c3aed,#4f46e5);
}

.equipButton{
    width:100%;
    margin-top:7px;
    background:#475569;
}

.equipButton.equipped{
    background:#16a34a;
}

.autocraftButton{
    width:100%;
    margin-top:7px;
    background:#334155;
}

.autocraftButton.active{
    background:#f59e0b;
    color:#111827;
}

.recipeProgress{
    margin-top:10px;
    background:#0f172a;
    border-radius:12px;
    padding:10px;
    font-size:12px;
    color:#cbd5e1;
    line-height:1.7;
}

.equippedBanner{
    text-align:center;
    padding:11px;
    border-radius:12px;
    background:rgba(34,197,94,.12);
    border:1px solid #16a34a;
    color:#4ade80;
    font-weight:900;
}

/* PROGRESS */

.progress{
    height:9px;
    background:#0f172a;
    border-radius:20px;
    overflow:hidden;
    margin:9px 0;
}

.progressBar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#8b5cf6,#06b6d4);
    transition:.3s;
}

/* ANIMATIONS */

.rolling{
    animation:rolling .07s linear infinite;
}

@keyframes rolling{
    0%{transform:rotateX(0)}
    50%{transform:rotateX(90deg)}
    100%{transform:rotateX(180deg)}
}

.newAura{
    animation:newAura 1.1s ease-in-out infinite;
}

@keyframes newAura{
    0%,100%{
        transform:scale(1);
        text-shadow:0 0 5px currentColor;
    }
    50%{
        transform:scale(1.25);
        text-shadow:
        0 0 12px currentColor,
        0 0 28px currentColor,
        0 0 55px currentColor;
    }
}

.ginger{
    animation:ginger 1s ease-in-out infinite;
}

@keyframes ginger{
    0%,100%{
        transform:scale(1);
        text-shadow:0 0 5px #ff8c00;
    }
    50%{
        transform:scale(1.3);
        text-shadow:
        0 0 15px #ff8c00,
        0 0 35px #ff4500,
        0 0 65px #ffd700;
    }
}

.legendary{
    animation:legendary 1.2s ease-in-out infinite;
}

@keyframes legendary{
    0%,100%{
        transform:scale(1);
        filter:brightness(1);
    }
    50%{
        transform:scale(1.2);
        filter:brightness(1.6);
    }
}

@media(max-width:500px){

    .tabs{
        grid-template-columns:repeat(2,1fr);
    }

    #auraName{
        font-size:34px;
    }

    .inventoryItem,
    .indexItem{
        grid-template-columns:1fr auto;
    }

    .chance{
        display:none;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">🎰 FRIEND RNG</div>
    <div class="subtitle">ROLL • DISCOVER • CRAFT • COLLECT</div>
</header>

<div class="container">

<div class="tabs">
<button class="tab active" onclick="showPage('roll',this)">🎰 Roll</button>
<button class="tab" onclick="showPage('inventory',this)">🎒 Inventory</button>
<button class="tab" onclick="showPage('index',this)">📖 Index</button>
<button class="tab" onclick="showPage('craft',this)">🛠️ Craft</button>
</div>


<!-- ROLL -->

<div id="roll" class="page active">

<div class="result">
<div class="resultGlow"></div>
<div id="auraName">???</div>
<div id="auraChance">Roll to discover an aura</div>
</div>

<div id="message" class="message"></div>

<button id="spinButton" onclick="spin()">🎲 SPIN</button>

<div class="card">
<h2>📊 Stats</h2>

<div class="stats">

<div class="stat">
<div class="statNumber" id="rollCount">0</div>
<div class="statLabel">ROLLS</div>
</div>

<div class="stat">
<div class="statNumber" id="inventoryCount">0/20</div>
<div class="statLabel">SPACE</div>
</div>

<div class="stat">
<div class="statNumber" id="playTime">0:00</div>
<div class="statLabel">PLAY TIME</div>
</div>

</div>
</div>


<div class="card">

<h2>🧪 Potions</h2>

<p>🍀 Luck: <strong id="luckPotions">0</strong></p>

<button class="potion luck" onclick="useLuckPotion()">
🍀 USE LUCK POTION
</button>

<p>⚡ Speed: <strong id="speedPotions">0</strong></p>

<button class="potion speed" onclick="useSpeedPotion()">
⚡ USE SPEED POTION
</button>

<p class="small">
Luck Potion every 2 minutes.<br>
Speed Potion every 3 minutes.
</p>

</div>


<div class="card">

<h2>🤖 Auto Roll</h2>

<p id="autoRollStatus">🔒 Unlocks at 75 rolls.</p>

<button id="autoRollButton"
class="craftButton"
onclick="toggleAutoRoll()"
disabled>
AUTO ROLL: LOCKED
</button>

</div>


<div class="card">

<h2>⚙️ Equipped Gadget</h2>

<div id="equippedGadget">
No gadget equipped.
</div>

<p class="small">
Only one gadget can be equipped at a time.
</p>

</div>


<div class="card">

<h2>🎒 Inventory Upgrade</h2>

<p id="upgradeText"></p>

<div class="progress">
<div id="upgradeProgress" class="progressBar"></div>
</div>

</div>

</div>


<!-- INVENTORY -->

<div id="inventory" class="page">

<div class="card">

<h2>🎒 Inventory</h2>

<p class="small">
Delete auras whenever you need room.
</p>

<div id="inventoryList"></div>

</div>


<div class="card">

<h2>🗑️ Auto Delete</h2>

<p class="small">
Turn this on for any aura you don't want to keep.
</p>

<div id="autoDeleteList"></div>

</div>

</div>


<!-- INDEX -->

<div id="index" class="page">

<div class="card">

<h2>📖 Aura Index</h2>

<p class="small">
Undiscovered auras remain hidden until you find them.
</p>

<div id="indexList"></div>

</div>

</div>


<!-- CRAFT -->

<div id="craft" class="page">

<div id="craftMessage" class="message"></div>


<div class="gadget calebGadget">

<div class="gadgetTop">

<div class="gadgetIcon calebIcon">🎰</div>

<div>
<div class="gadgetName">Caleb Roller</div>

<div class="gadgetEffect">
Improves your chances of Caleb-related auras.
</div>
</div>

</div>

<div>
<span class="material">Caleb × 50</span>
</div>

<div id="calebProgress" class="recipeProgress"></div>

<button class="craftButton"
onclick="craftGadget('calebRoller')">
CRAFT CALEB ROLLER
</button>

<button id="equipCaleb"
class="equipButton"
onclick="equipGadget('calebRoller')">
EQUIP
</button>

<button id="autoCaleb"
class="autocraftButton"
onclick="toggleAutoCraft('calebRoller')">
AUTO-CRAFT: OFF
</button>

</div>


<div class="gadget">

<div class="gadgetTop">

<div class="gadgetIcon">⚡</div>

<div>

<div class="gadgetName">
1.75× Rolling Speed
</div>

<div class="gadgetEffect">
Makes your rolling animation happen 1.75× faster.
</div>

</div>

</div>

<div>

<span class="material">Kevin × 5</span>
<span class="material">Erik × 3</span>
<span class="material">Cayden × 1</span>

</div>

<div id="speedProgress" class="recipeProgress"></div>

<button class="craftButton"
onclick="craftGadget('speed')">
CRAFT SPEED GADGET
</button>

<button id="equipSpeed"
class="equipButton"
onclick="equipGadget('speed')">
EQUIP
</button>

<button id="autoSpeed"
class="autocraftButton"
onclick="toggleAutoCraft('speed')">
AUTO-CRAFT: OFF
</button>

</div>


<div class="gadget freshGadget">

<div class="gadgetTop">

<div class="gadgetIcon freshIcon">🥩</div>

<div>

<div class="gadgetName">
Fresh Meat Gadget
</div>

<div class="gadgetEffect">
Gives you 2× Luck while equipped.
</div>

</div>

</div>

<div>

<span class="material">Derek × 1</span>
<span class="material">Caleb × 1</span>
<span class="material">Ravar × 1</span>
<span class="material">Silas × 1</span>
<span class="material">Nick × 1</span>

</div>

<div id="freshProgress" class="recipeProgress"></div>

<button class="craftButton"
onclick="craftGadget('freshest')">
CRAFT FRESH MEAT
</button>

<button id="equipFreshest"
class="equipButton"
onclick="equipGadget('freshest')">
EQUIP
</button>

<button id="autoFreshest"
class="autocraftButton"
onclick="toggleAutoCraft('freshest')">
AUTO-CRAFT: OFF
</button>

</div>


<div class="card">

<h2>⚙️ Gadget Rules</h2>

<p class="small">

• You can own multiple gadgets.<br><br>

• You can equip only ONE gadget at a time.<br><br>

• Equipping another gadget automatically unequips the old one.<br><br>

• Only ONE Auto-Craft recipe can be active at a time.<br><br>

• Auto-Craft automatically crafts a gadget when you have the required auras.<br><br>

• Fresh Meat gives 2× Luck.<br><br>

• Caleb Roller improves Caleb-related chances.

</p>

</div>

</div>

</div>


<script>

/* =========================================================
   AURAS
========================================================= */

const auras = [

{name:"Ravar",chance:1/4,display:"1/4",color:"#ef4444"},
{name:"Caleb",chance:1/6,display:"1/6",color:"#3b82f6"},
{name:"Aidan",chance:1/8,display:"1/8",color:"#22c55e"},
{name:"Kevin",chance:1/16,display:"1/16",color:"#eab308"},
{name:"Erik",chance:1/32,display:"1/32",color:"#a855f7"},
{name:"Sussy Kevin",chance:1/69,display:"1/69",color:"#14b8a6"},
{name:"Cayden",chance:1/75,display:"1/75",color:"#06b6d4"},
{name:"3 Ball Caleb",chance:1/100,display:"1/100",color:"#ec4899"},
{name:"Silas",chance:1/150,display:"1/150",color:"#22d3ee"},
{name:"Nick",chance:1/165,display:"1/165",color:"#f97316"},
{name:"Big Buff Erik",chance:1/200,display:"1/200",color:"#f43f5e"},
{name:"Derek",chance:1/300,display:"1/300",color:"#f472b6"},
{name:"Ginger Erik",chance:1/500,display:"1/500",color:"#ff8c00",ginger:true},
{name:"Easton",chance:1/750,display:"1/750",color:"#8b5cf6"},
{name:"Deku Nick",chance:1/1000,display:"1/1000",color:"#facc15",legendary:true}

];


/* =========================================================
   LOAD DATA
========================================================= */

function loadJSON(key,fallback){
    try{
        const data=JSON.parse(localStorage.getItem(key));
        return data ?? fallback;
    }catch{
        return fallback;
    }
}

let inventory=loadJSON("friend_rng_inventory",[]);
let discovered=loadJSON("friend_rng_discovered",[]);
let autoDelete=loadJSON("friend_rng_autodelete",[]);

let rolls=Number(localStorage.getItem("friend_rng_rolls")||0);
let secondsPlayed=Number(localStorage.getItem("friend_rng_time")||0);

let luckPotions=Number(localStorage.getItem("friend_rng_luck")||0);
let speedPotions=Number(localStorage.getItem("friend_rng_speed")||0);

let gadgets=loadJSON(
    "friend_rng_gadgets",
    {
        calebRoller:false,
        speed:false,
        freshest:false
    }
);

let equippedGadget=
    localStorage.getItem("friend_rng_equipped")||"";

let autoCraft=
    localStorage.getItem("friend_rng_autocraft")||"";

let autoRoll=
    localStorage.getItem("friend_rng_autoroll")==="true";

let luckActive=false;
let speedActive=false;
let spinning=false;


/* =========================================================
   RECIPES
========================================================= */

const recipes={

calebRoller:{
    Caleb:50
},

speed:{
    Kevin:5,
    Erik:3,
    Cayden:1
},

freshest:{
    Derek:1,
    Caleb:1,
    Ravar:1,
    Silas:1,
    Nick:1
}

};


/* =========================================================
   SAVE
========================================================= */

function save(){

localStorage.setItem(
    "friend_rng_inventory",
    JSON.stringify(inventory)
);

localStorage.setItem(
    "friend_rng_discovered",
    JSON.stringify(discovered)
);

localStorage.setItem(
    "friend_rng_autodelete",
    JSON.stringify(autoDelete)
);

localStorage.setItem(
    "friend_rng_rolls",
    rolls
);

localStorage.setItem(
    "friend_rng_time",
    secondsPlayed
);

localStorage.setItem(
    "friend_rng_luck",
    luckPotions
);

localStorage.setItem(
    "friend_rng_speed",
    speedPotions
);

localStorage.setItem(
    "friend_rng_gadgets",
    JSON.stringify(gadgets)
);

localStorage.setItem(
    "friend_rng_equipped",
    equippedGadget
);

localStorage.setItem(
    "friend_rng_autocraft",
    autoCraft
);

localStorage.setItem(
    "friend_rng_autoroll",
    autoRoll
);

}


/* =========================================================
   INVENTORY
========================================================= */

function inventoryLimit(){

if(rolls>=200)return 100;
if(rolls>=100)return 60;
if(rolls>=50)return 40;

return 20;

}


function countAura(name){

return inventory.filter(
    x=>x.name===name
).length;

}


/* =========================================================
   RECIPE
========================================================= */

function hasRecipe(recipe){

for(const name in recipe){

if(countAura(name)<recipe[name]){
return false;
}

}

return true;

}


function removeRecipe(recipe){

if(!hasRecipe(recipe))return false;

for(const name in recipe){

let amount=recipe[name];

for(let i=0;i<amount;i++){

const index=
inventory.findIndex(
    x=>x.name===name
);

if(index!==-1){
inventory.splice(index,1);
}

}

}

return true;

}


/* =========================================================
   CRAFT
========================================================= */

function craftGadget(type){

if(gadgets[type]){

craftMessage("You already own this gadget.");

return;

}

if(!hasRecipe(recipes[type])){

craftMessage("❌ You don't have the required auras.");

return;

}

removeRecipe(recipes[type]);

gadgets[type]=true;

save();
updateAll();

craftMessage("🛠️ Gadget crafted!");

}


/* =========================================================
   EQUIP
========================================================= */

function equipGadget(type){

if(!gadgets[type]){

craftMessage("Craft the gadget first.");

return;

}

if(equippedGadget===type){

equippedGadget="";

}else{

equippedGadget=type;

}

save();
updateAll();

}


/* =========================================================
   AUTO CRAFT
========================================================= */

function toggleAutoCraft(type){

if(!gadgets[type]){

craftMessage("Craft the gadget first.");

return;

}

if(autoCraft===type){

autoCraft="";

}else{

autoCraft=type;

}

save();
updateAll();

}


/*
   Auto-craft is mainly useful if the recipe becomes
   available before the player owns the gadget.
*/

function processAutoCraft(){

if(!autoCraft)return;

/*
   If already owned, turn auto-craft off.
*/

if(gadgets[autoCraft]){

autoCraft="";

save();

return;

}

if(hasRecipe(recipes[autoCraft])){

removeRecipe(recipes[autoCraft]);

gadgets[autoCraft]=true;

autoCraft="";

save();

craftMessage(
    "🛠️ AUTO-CRAFT COMPLETE!"
);

}

}


/* =========================================================
   RNG
========================================================= */

/*
   IMPORTANT:
   The old version treated 1/4, 1/6, 1/8 etc.
   as simple weights.

   This version uses the actual inverse odds.

   That means:
   1/4 is genuinely much more common than 1/1000.
*/

function getRandomAura(){

let luckMultiplier=1;


/* Every 10th roll gives 2× luck */

if(rolls%10===0){
luckMultiplier*=2;
}


/* Luck potion */

if(luckActive){
luckMultiplier*=1.5;
}


/* Fresh Meat */

if(equippedGadget==="freshest"){
luckMultiplier*=2;
}


/*
   Convert 1/X odds into weights.
   Rarer auras receive the stronger luck bonus.
*/

let list=[];
let total=0;

for(const aura of auras){

let weight=aura.chance;


/*
   Luck increases rare aura weights.

   The rarer the aura, the more it benefits.
*/

if(luckMultiplier>1){

const rarity=1/aura.chance;

const rarityBonus=
    Math.min(
        5,
        Math.log10(rarity)
    );

weight *=
    1 +
    ((luckMultiplier-1)*rarityBonus);

}


/* Caleb Roller */

if(equippedGadget==="calebRoller"){

if(aura.name==="Caleb"){
weight*=2.5;
}

if(aura.name==="3 Ball Caleb"){
weight*=1.8;
}

}


list.push({
    aura:aura,
    weight:weight
});

total+=weight;

}


/* Weighted selection */

let random=Math.random()*total;

for(const item of list){

random-=item.weight;

if(random<=0){
return item.aura;
}

}

return auras[0];

}


/* =========================================================
   SPIN
========================================================= */

function spin(){

if(spinning)return;


/* Inventory full */

if(inventory.length>=inventoryLimit()){

showMessage(
    "🎒 Inventory full! Delete something first."
);

autoRoll=false;

save();
updateAll();

return;

}


spinning=true;

const spinButton=
document.getElementById("spinButton");

spinButton.disabled=true;


/*
   Count roll BEFORE calculating the result
   so every 10th roll works correctly.
*/

rolls++;


const result=getRandomAura();

const name=
document.getElementById("auraName");

const chance=
document.getElementById("auraChance");


/* Reset animations */

name.className="";
name.style.color="#475569";

name.classList.add("rolling");


/* Base duration */

let duration=1200;


/* Speed gadget */

if(equippedGadget==="speed"){
duration/=1.75;
}


/* Speed potion */

if(speedActive){
duration/=1.5;
}


/* Preview */

const fake=setInterval(()=>{

const fakeAura=
    auras[
        Math.floor(
            Math.random()*auras.length
        )
    ];


if(discovered.includes(fakeAura.name)){

name.textContent=fakeAura.name;
name.style.color=fakeAura.color;

}else{

name.textContent="???";
name.style.color="#475569";

}

},70);


/* Finish */

setTimeout(()=>{

clearInterval(fake);

name.className="";

const isNew=
    !discovered.includes(result.name);


/* Discovery */

if(isNew){

discovered.push(result.name);

showMessage(
    "✨ NEW AURA: "+result.name+"!"
);

}else{

showMessage(
    "You rolled "+result.name+"!"
);

}


/* Display */

name.textContent=result.name;
name.style.color=result.color;

chance.textContent=
    "Chance: "+result.display;


/* Special animations */

if(result.ginger){
name.classList.add("ginger");
}

if(result.legendary){
name.classList.add("legendary");
}

if(isNew && !result.ginger && !result.legendary){
name.classList.add("newAura");
}


/* Auto-delete */

if(autoDelete.includes(result.name)){

showMessage(
    "🗑️ "+result.name+" was auto-deleted."
);

}else{

inventory.push({

name:result.name,
chance:result.display,
color:result.color,

id:
    Date.now()+
    "-" +
    Math.random()
        .toString(36)
        .slice(2)

});

}


/* Auto craft */

processAutoCraft();


/* Potions only affect ONE roll */

luckActive=false;
speedActive=false;


save();
updateAll();


spinning=false;

spinButton.disabled=false;


/* Auto-roll */

if(
autoRoll &&
inventory.length<inventoryLimit()
){

setTimeout(()=>{

if(autoRoll){
spin();
}

},300);

}


},duration);

}


/* =========================================================
   POTIONS
========================================================= */

function useLuckPotion(){

if(luckPotions<=0){

showMessage(
    "You don't have a Luck Potion."
);

return;

}

if(spinning){

showMessage(
    "Wait until the current roll finishes."
);

return;

}

luckPotions--;
luckActive=true;

save();
updateAll();

showMessage(
    "🍀 Luck activated for your next roll!"
);

}


function useSpeedPotion(){

if(speedPotions<=0){

showMessage(
    "You don't have a Speed Potion."
);

return;

}

if(spinning){

showMessage(
    "Wait until the current roll finishes."
);

return;

}

speedPotions--;
speedActive=true;

save();
updateAll();

showMessage(
    "⚡ Speed activated for your next roll!"
);

}


/* =========================================================
   AUTO ROLL
========================================================= */

function toggleAutoRoll(){

if(rolls<75)return;

autoRoll=!autoRoll;

save();
updateAll();

if(autoRoll && !spinning){

spin();

}

}


/* =========================================================
   DELETE
========================================================= */

function deleteAura(id){

inventory=
inventory.filter(
    x=>String(x.id)!==String(id)
);

save();
updateAll();

}


/* =========================================================
   AUTO DELETE
========================================================= */

function toggleAutoDelete(name){

if(autoDelete.includes(name)){

autoDelete=
    autoDelete.filter(
        x=>x!==name
    );

}else{

autoDelete.push(name);

}

save();
updateAll();

}


/* =========================================================
   PAGE SWITCH
========================================================= */

function showPage(page,button){

document
.querySelectorAll(".page")
.forEach(
    x=>x.classList.remove("active")
);

document
.getElementById(page)
.classList.add("active");

document
.querySelectorAll(".tab")
.forEach(
    x=>x.classList.remove("active")
);

button.classList.add("active");

updateAll();

}


/* =========================================================
   INVENTORY UI
========================================================= */

function updateInventory(){

const box=
document.getElementById("inventoryList");

box.innerHTML="";


if(inventory.length===0){

box.innerHTML=
    '<div class="empty">Your inventory is empty.</div>';

return;

}


inventory.forEach(aura=>{

const item=
document.createElement("div");

item.className="inventoryItem";


const name=
document.createElement("span");

name.className="auraText";
name.style.color=aura.color;
name.textContent=aura.name;


const chance=
document.createElement("span");

chance.className="chance";
chance.textContent=aura.chance;


const button=
document.createElement("button");

button.className="delete";
button.textContent="DELETE";

button.onclick=()=>{
    deleteAura(aura.id);
};


item.appendChild(name);
item.appendChild(chance);
item.appendChild(button);

box.appendChild(item);

});

}


/* =========================================================
   AUTO DELETE UI
========================================================= */

function updateAutoDelete(){

const box=
document.getElementById("autoDeleteList");

box.innerHTML="";


auras.forEach(aura=>{

const known=
    discovered.includes(aura.name);

const active=
    autoDelete.includes(aura.name);


const item=
    document.createElement("div");

item.className="autoItem";


const name=
    document.createElement("span");

name.style.color=
    known ? aura.color : "#475569";

name.style.fontWeight="900";

name.textContent=
    known ? aura.name : "???";


const button=
    document.createElement("button");

button.className=
    "autoButton"+
    (active ? " active" : "");

button.textContent=
    active
    ? "AUTO DELETE ON"
    : "AUTO DELETE";

button.onclick=()=>{
    toggleAutoDelete(aura.name);
};


item.appendChild(name);
item.appendChild(button);

box.appendChild(item);

});

}


/* =========================================================
   INDEX
========================================================= */

function updateIndex(){

const box=
document.getElementById("indexList");

box.innerHTML="";


auras.forEach(aura=>{

const known=
    discovered.includes(aura.name);


const item=
    document.createElement("div");

item.className="indexItem";


const name=
    document.createElement("span");

name.className="auraText";
name.style.color=
    known ? aura.color : "#475569";

name.textContent=
    known ? aura.name : "???";


const chance=
    document.createElement("span");

chance.className="chance";

chance.textContent=
    known ? aura.display : "???";


const status=
    document.createElement("span");

status.textContent=
    known ? "✅" : "🔒";


item.appendChild(name);
item.appendChild(chance);
item.appendChild(status);

box.appendChild(item);

});

}


/* =========================================================
   CRAFT UI
========================================================= */

function updateCraft(){

updateRecipe(
    recipes.calebRoller,
    "calebProgress"
);

updateRecipe(
    recipes.speed,
    "speedProgress"
);

updateRecipe(
    recipes.freshest,
    "freshProgress"
);


updateGadgetButton(
    "calebRoller",
    "equipCaleb",
    "autoCaleb"
);

updateGadgetButton(
    "speed",
    "equipSpeed",
    "autoSpeed"
);

updateGadgetButton(
    "freshest",
    "equipFreshest",
    "autoFreshest"
);

}


function updateRecipe(recipe,id){

const box=
    document.getElementById(id);

let html="";


for(const name in recipe){

const have=countAura(name);
const needed=recipe[name];

const check=
    have>=needed
    ? "✅"
    : "❌";

html+=
`${check} ${name}: ${Math.min(have,needed)}/${needed}<br>`;

}


box.innerHTML=html;

}


/* =========================================================
   GADGET BUTTONS
========================================================= */

function updateGadgetButton(
    type,
    equipID,
    autoID
){

const equip=
    document.getElementById(equipID);

const auto=
    document.getElementById(autoID);


if(gadgets[type]){

equip.textContent=
    equippedGadget===type
    ? "UNEQUIP"
    : "EQUIP";

equip.classList.toggle(
    "equipped",
    equippedGadget===type
);


auto.textContent=
    autoCraft===type
    ? "AUTO-CRAFT: ON"
    : "AUTO-CRAFT: OFF";

auto.classList.toggle(
    "active",
    autoCraft===type
);

}else{

equip.textContent="CRAFT IT FIRST";
auto.textContent="CRAFT IT FIRST";

}

}


/* =========================================================
   EQUIPPED GADGET
========================================================= */

function updateEquipped(){

const box=
    document.getElementById("equippedGadget");


if(!equippedGadget){

box.innerHTML=
    '<span class="small">No gadget equipped.</span>';

return;

}


if(equippedGadget==="calebRoller"){

box.innerHTML=
`
<div class="equippedBanner">
🎰 CALEB ROLLER EQUIPPED<br>
<span class="small">
Better Caleb-related chances
</span>
</div>
`;

}


if(equippedGadget==="speed"){

box.innerHTML=
`
<div class="equippedBanner">
⚡ 1.75× SPEED EQUIPPED<br>
<span class="small">
Faster rolls
</span>
</div>
`;

}


if(equippedGadget==="freshest"){

box.innerHTML=
`
<div class="equippedBanner">
🥩 FRESH MEAT EQUIPPED<br>
<span class="small">
2× Luck
</span>
</div>
`;

}

}


/* =========================================================
   INVENTORY UPGRADE
========================================================= */

function updateUpgrade(){

const limit=
    inventoryLimit();


document
.getElementById("inventoryCount")
.textContent=
    inventory.length+"/"+limit;


const text=
    document.getElementById("upgradeText");

const bar=
    document.getElementById("upgradeProgress");


if(rolls<50){

text.textContent=
    "🔒 40 slots unlock at 50 rolls.";

bar.style.width=
    (rolls/50*100)+"%";

}

else if(rolls<100){

text.textContent=
    "🎒 40 slots unlocked! 60 slots at 100 rolls.";

bar.style.width=
    ((rolls-50)/50*100)+"%";

}

else if(rolls<200){

text.textContent=
    "🎒 60 slots unlocked! 100 slots at 200 rolls.";

bar.style.width=
    ((rolls-100)/100*100)+"%";

}

else{

text.textContent=
    "🏆 MAX INVENTORY: 100 SLOTS";

bar.style.width="100%";

}

}


/* =========================================================
   AUTO ROLL UI
========================================================= */

function updateAutoRoll(){

const button=
    document.getElementById("autoRollButton");

const status=
    document.getElementById("autoRollStatus");


if(rolls>=75){

button.disabled=false;

button.textContent=
    autoRoll
    ? "AUTO ROLL: ON"
    : "AUTO ROLL: OFF";

status.textContent=
    autoRoll
    ? "🤖 Auto Roll is active."
    : "✅ Auto Roll unlocked!";

}else{

button.disabled=true;

button.textContent=
    "AUTO ROLL: LOCKED";

status.textContent=
    "🔒 Unlocks at 75 rolls. "+
    (75-rolls)+
    " more rolls.";

}

}


/* =========================================================
   MESSAGES
========================================================= */

let messageTimer=null;

function showMessage(text){

const box=
    document.getElementById("message");

box.textContent=text;

clearTimeout(messageTimer);

messageTimer=
    setTimeout(()=>{
        if(box.textContent===text){
            box.textContent="";
        }
    },4000);

}


function craftMessage(text){

const box=
    document.getElementById("craftMessage");

box.textContent=text;

setTimeout(()=>{

if(box.textContent===text){
box.textContent="";
}

},4000);

}


/* =========================================================
   UPDATE ALL
========================================================= */

function updateAll(){

document
.getElementById("rollCount")
.textContent=rolls;


document
.getElementById("luckPotions")
.textContent=luckPotions;


document
.getElementById("speedPotions")
.textContent=speedPotions;


const minutes=
    Math.floor(secondsPlayed/60);

const seconds=
    secondsPlayed%60;


document
.getElementById("playTime")
.textContent=
    minutes+
    ":"+
    String(seconds)
        .padStart(2,"0");


updateInventory();
updateAutoDelete();
updateIndex();
updateCraft();
updateEquipped();
updateUpgrade();
updateAutoRoll();

}


/* =========================================================
   PLAY TIME
========================================================= */

setInterval(()=>{

secondsPlayed++;


/* Luck every 2 minutes */

if(secondsPlayed%120===0){

luckPotions++;

showMessage(
    "🍀 You earned a Luck Potion!"
);

}


/* Speed every 3 minutes */

if(secondsPlayed%180===0){

speedPotions++;

showMessage(
    "⚡ You earned a Speed Potion!"
);

}


save();
updateAll();

},1000);


/* =========================================================
   START
========================================================= */

updateAll();

</script>

</body>
</html>
