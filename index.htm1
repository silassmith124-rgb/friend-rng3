<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Friend RNG</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,sans-serif;
color:white;
min-height:100vh;
background:
radial-gradient(circle at 10% 0%,#4c1d95,transparent 30%),
radial-gradient(circle at 90% 10%,#164e63,transparent 28%),
linear-gradient(145deg,#020617,#0f172a 55%,#111827);
}

button{
border:0;
border-radius:13px;
padding:11px 15px;
color:white;
font-weight:800;
cursor:pointer;
}

button:active{transform:scale(.96)}

header{
text-align:center;
padding:22px 12px;
background:rgba(2,6,23,.94);
border-bottom:1px solid #334155;
}

.logo{
font-size:32px;
font-weight:1000;
letter-spacing:2px;
}

.subtitle{
color:#94a3b8;
font-size:13px;
margin-top:5px;
}

.container{
width:94%;
max-width:760px;
margin:auto;
padding:16px 0 60px;
}

.tabs{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:6px;
margin-bottom:15px;
}

.tab{
background:#1e293b;
color:#94a3b8;
padding:12px 5px;
}

.tab.active{
background:linear-gradient(135deg,#7c3aed,#4f46e5);
color:white;
box-shadow:0 5px 18px rgba(99,102,241,.3);
}

.page{display:none}
.page.active{display:block}

.card{
background:rgba(30,41,59,.91);
border:1px solid rgba(255,255,255,.08);
border-radius:21px;
padding:18px;
margin-bottom:15px;
box-shadow:0 14px 35px rgba(0,0,0,.24);
}

h2{margin-top:0}

.small{
color:#94a3b8;
font-size:13px;
}

.message{
min-height:25px;
text-align:center;
color:#facc15;
font-weight:900;
margin:8px;
}


/* ROLL */

.result{
height:250px;
border-radius:26px;
background:radial-gradient(circle,#1e293b,#020617 75%);
border:1px solid #334155;
display:flex;
align-items:center;
justify-content:center;
flex-direction:column;
text-align:center;
overflow:hidden;
position:relative;
}

.resultGlow{
position:absolute;
width:240px;
height:240px;
border-radius:50%;
background:rgba(99,102,241,.12);
filter:blur(45px);
}

#auraName{
position:relative;
z-index:2;
font-size:42px;
font-weight:1000;
}

#auraChance{
position:relative;
z-index:2;
color:#94a3b8;
margin-top:7px;
}

#spinButton{
width:100%;
margin:14px 0;
padding:18px;
font-size:23px;
background:linear-gradient(135deg,#8b5cf6,#6366f1);
box-shadow:0 9px 30px rgba(99,102,241,.35);
}

#spinButton:disabled{
opacity:.45;
}


/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:7px;
}

.stat{
background:#334155;
border-radius:14px;
padding:13px 5px;
text-align:center;
}

.statNumber{
font-size:21px;
font-weight:1000;
}

.statLabel{
font-size:10px;
color:#94a3b8;
margin-top:3px;
}


/* POTIONS */

.potion{
width:100%;
margin:5px 0;
}

.luck{
background:linear-gradient(135deg,#16a34a,#22c55e);
}

.speed{
background:linear-gradient(135deg,#0284c7,#06b6d4);
}


/* INVENTORY */

.inventoryItem,
.indexItem{
display:grid;
grid-template-columns:1fr auto auto;
align-items:center;
gap:8px;
background:#334155;
border-radius:12px;
padding:10px;
margin:6px 0;
}

.auraText{
font-weight:900;
}

.chance{
color:#94a3b8;
font-size:12px;
}

.delete{
background:#ef4444;
padding:7px 9px;
font-size:11px;
}

.empty{
color:#64748b;
text-align:center;
padding:25px;
}


/* AUTO DELETE */

.autoItem{
display:flex;
justify-content:space-between;
align-items:center;
gap:8px;
padding:9px;
border-bottom:1px solid #334155;
}

.autoItem:last-child{
border-bottom:0;
}

.autoButton{
background:#475569;
font-size:10px;
padding:7px;
}

.autoButton.active{
background:#dc2626;
}


/* GADGETS */

.gadget{
border-radius:20px;
padding:17px;
margin-bottom:15px;
background:linear-gradient(145deg,#172033,#0f172a);
border:1px solid #475569;
position:relative;
overflow:hidden;
}

.gadget::after{
content:"";
position:absolute;
width:130px;
height:130px;
border-radius:50%;
right:-50px;
top:-50px;
background:rgba(255,255,255,.06);
}

.speedGadget{
border-color:#0891b2;
box-shadow:0 0 25px rgba(6,182,212,.12);
}

.freshGadget{
border-color:#db2777;
box-shadow:0 0 30px rgba(236,72,153,.16);
}

.calebGadget{
border-color:#f59e0b;
box-shadow:0 0 25px rgba(245,158,11,.12);
}

.gadgetTop{
display:flex;
align-items:center;
gap:13px;
}

.gadgetIcon{
width:64px;
height:64px;
border-radius:18px;
display:flex;
align-items:center;
justify-content:center;
font-size:32px;
background:linear-gradient(135deg,#0891b2,#1d4ed8);
}

.freshIcon{
background:linear-gradient(135deg,#ec4899,#7c3aed);
}

.calebIcon{
background:linear-gradient(135deg,#f59e0b,#dc2626);
}

.gadgetName{
font-size:19px;
font-weight:1000;
}

.gadgetEffect{
color:#cbd5e1;
font-size:13px;
margin-top:3px;
}

.recipeMaterials{
margin-top:12px;
}

.material{
display:inline-block;
padding:6px 8px;
margin:3px;
border-radius:9px;
background:#334155;
font-size:12px;
}

.craftButton{
width:100%;
margin-top:10px;
background:linear-gradient(135deg,#7c3aed,#4f46e5);
}

.equipButton{
width:100%;
margin-top:7px;
background:#475569;
}

.equipButton.equipped{
background:#16a34a;
}

.autocraftButton{
width:100%;
margin-top:7px;
background:#334155;
}

.autocraftButton.active{
background:#f59e0b;
color:#111827;
}

.equippedBanner{
text-align:center;
padding:10px;
border-radius:12px;
background:rgba(34,197,94,.12);
border:1px solid #16a34a;
color:#4ade80;
font-weight:900;
}


/* RECIPE PROGRESS */

.recipeProgress{
margin-top:10px;
background:#0f172a;
border-radius:12px;
padding:10px;
font-size:12px;
color:#cbd5e1;
}


/* PROGRESS */

.progress{
height:9px;
background:#0f172a;
border-radius:20px;
overflow:hidden;
margin:9px 0;
}

.progressBar{
height:100%;
background:linear-gradient(90deg,#8b5cf6,#06b6d4);
}


/* ANIMATIONS */

.rolling{
animation:rolling .07s linear infinite;
}

@keyframes rolling{
0%{transform:rotateX(0)}
50%{transform:rotateX(90deg)}
100%{transform:rotateX(180deg)}
}

.newAura{
animation:newAura 1.4s ease-in-out infinite;
}

@keyframes newAura{
0%,100%{
transform:scale(1);
text-shadow:0 0 5px currentColor;
}
50%{
transform:scale(1.25);
text-shadow:
0 0 12px currentColor,
0 0 28px currentColor,
0 0 55px currentColor;
}
}

.ginger{
animation:ginger 1s ease-in-out infinite;
}

@keyframes ginger{
0%,100%{
transform:scale(1);
text-shadow:0 0 5px #ff8c00;
}
50%{
transform:scale(1.3);
text-shadow:
0 0 15px #ff8c00,
0 0 35px #ff4500,
0 0 65px #ffd700;
}
}


/* MOBILE */

@media(max-width:500px){

.tabs{
grid-template-columns:repeat(2,1fr);
}

#auraName{
font-size:34px;
}

.inventoryItem,
.indexItem{
grid-template-columns:1fr auto;
}

.chance{
display:none;
}

}
</style>
</head>


<body>

<header>
<div class="logo">🎰 FRIEND RNG</div>
<div class="subtitle">ROLL • DISCOVER • CRAFT • COLLECT</div>
</header>


<div class="container">


<!-- TABS -->

<div class="tabs">

<button class="tab active"
onclick="showPage('roll',this)">
🎰 Roll
</button>

<button class="tab"
onclick="showPage('inventory',this)">
🎒 Inventory
</button>

<button class="tab"
onclick="showPage('index',this)">
📖 Index
</button>

<button class="tab"
onclick="showPage('craft',this)">
🛠️ Craft
</button>

</div>


<!-- ROLL PAGE -->

<div id="roll" class="page active">

<div class="result">

<div class="resultGlow"></div>

<div id="auraName">???</div>

<div id="auraChance">
Roll to discover an aura
</div>

</div>

<div id="message" class="message"></div>

<button id="spinButton"
onclick="spin()">
🎲 SPIN
</button>


<div class="card">

<h2>📊 Stats</h2>

<div class="stats">

<div class="stat">
<div class="statNumber" id="rollCount">0</div>
<div class="statLabel">ROLLS</div>
</div>

<div class="stat">
<div class="statNumber" id="inventoryCount">
0/20
</div>
<div class="statLabel">SPACE</div>
</div>

<div class="stat">
<div class="statNumber" id="playTime">
0:00
</div>
<div class="statLabel">PLAY TIME</div>
</div>

</div>

</div>


<div class="card">

<h2>🧪 Potions</h2>

<p>
🍀 Luck:
<strong id="luckPotions">0</strong>
</p>

<button class="potion luck"
onclick="useLuckPotion()">
🍀 USE LUCK POTION
</button>

<p>
⚡ Speed:
<strong id="speedPotions">0</strong>
</p>

<button class="potion speed"
onclick="useSpeedPotion()">
⚡ USE SPEED POTION
</button>

<p class="small">
Luck Potion every 2 minutes.<br>
Speed Potion every 3 minutes.
</p>

</div>


<div class="card">

<h2>🤖 Auto Roll</h2>

<p id="autoRollStatus">
🔒 Unlocks at 75 rolls.
</p>

<button id="autoRollButton"
class="craftButton"
onclick="toggleAutoRoll()"
disabled>
AUTO ROLL: LOCKED
</button>

</div>


<div class="card">

<h2>⚙️ Equipped Gadget</h2>

<div id="equippedGadget">
No gadget equipped.
</div>

<p class="small">
Only one gadget can be equipped at a time.
</p>

</div>


<div class="card">

<h2>🎒 Inventory Progress</h2>

<p id="upgradeText"></p>

<div class="progress">
<div id="upgradeProgress"
class="progressBar"
style="width:0%">
</div>
</div>

</div>

</div>


<!-- INVENTORY -->

<div id="inventory" class="page">

<div class="card">

<h2>🎒 Inventory</h2>

<p class="small">
Delete anything you don't want.
</p>

<div id="inventoryList"></div>

</div>


<div class="card">

<h2>🗑️ Auto Delete</h2>

<p class="small">
Automatically delete selected auras when they are rolled.
</p>

<div id="autoDeleteList"></div>

</div>

</div>


<!-- INDEX -->

<div id="index" class="page">

<div class="card">

<h2>📖 Aura Index</h2>

<p class="small">
Undiscovered auras stay hidden.
</p>

<div id="indexList"></div>

</div>

</div>


<!-- CRAFT -->

<div id="craft" class="page">

<div id="craftMessage"
class="message">
</div>


<!-- CALEB ROLLER -->

<div class="gadget calebGadget">

<div class="gadgetTop">

<div class="gadgetIcon calebIcon">
🎰
</div>

<div>

<div class="gadgetName">
Caleb Roller
</div>

<div class="gadgetEffect">
Improves your chance of getting
Caleb-related auras.
</div>

</div>

</div>

<div class="recipeMaterials">

<span class="material">
Caleb × 50
</span>

</div>

<div id="calebProgress"
class="recipeProgress">
</div>

<button class="craftButton"
onclick="craftGadget('calebRoller')">
CRAFT CALEB ROLLER
</button>

<button id="equipCaleb"
class="equipButton"
onclick="equipGadget('calebRoller')">
EQUIP
</button>

<button id="autoCaleb"
class="autocraftButton"
onclick="toggleAutoCraft('calebRoller')">
AUTO-CRAFT: OFF
</button>

</div>


<!-- SPEED GADGET -->

<div class="gadget speedGadget">

<div class="gadgetTop">

<div class="gadgetIcon">
⚡
</div>

<div>

<div class="gadgetName">
1.75× Rolling Speed
</div>

<div class="gadgetEffect">
Makes rolls happen 1.75× faster.
</div>

</div>

</div>

<div class="recipeMaterials">

<span class="material">
Kevin × 5
</span>

<span class="material">
Erik × 3
</span>

<span class="material">
Cayden × 1
</span>

</div>

<div id="speedProgress"
class="recipeProgress">
</div>

<button class="craftButton"
onclick="craftGadget('speed')">
CRAFT SPEED GADGET
</button>

<button id="equipSpeed"
class="equipButton"
onclick="equipGadget('speed')">
EQUIP
</button>

<button id="autoSpeed"
class="autocraftButton"
onclick="toggleAutoCraft('speed')">
AUTO-CRAFT: OFF
</button>

</div>


<!-- FRESH MEAT -->

<div class="gadget freshGadget">

<div class="gadgetTop">

<div class="gadgetIcon freshIcon">
🥩
</div>

<div>

<div class="gadgetName">
Fresh Meat Gadget
</div>

<div class="gadgetEffect">
Gives you 2× Luck while equipped.
</div>

</div>

</div>

<div class="recipeMaterials">

<span class="material">
Derek × 1
</span>

<span class="material">
Caleb × 1
</span>

<span class="material">
Ravar × 1
</span>

<span class="material">
Silas × 1
</span>

<span class="material">
Nick × 1
</span>

</div>

<div id="freshProgress"
class="recipeProgress">
</div>

<button class="craftButton"
onclick="craftGadget('freshest')">
CRAFT FRESH MEAT
</button>

<button id="equipFreshest"
class="equipButton"
onclick="equipGadget('freshest')">
EQUIP
</button>

<button id="autoFreshest"
class="autocraftButton"
onclick="toggleAutoCraft('freshest')">
AUTO-CRAFT: OFF
</button>

</div>


<div class="card">

<h2>⚙️ Gadget Rules</h2>

<p class="small">

• You can own multiple gadgets.

<br><br>

• You can equip only ONE gadget.

<br><br>

• Equipping another gadget automatically
unequips your current gadget.

<br><br>

• Only ONE Auto-Craft recipe can be active.

<br><br>

• Auto-Craft automatically contributes
matching rolls toward that recipe.

<br><br>

• Fresh Meat = 2× Luck.

</p>

</div>

</div>

</div>


<script>

/* ================================
   AURAS
================================ */

const auras = [

{name:"Ravar",chance:1/4,display:"1/4",color:"#ef4444"},

{name:"Caleb",chance:1/6,display:"1/6",color:"#3b82f6"},

{name:"Aidan",chance:1/8,display:"1/8",color:"#22c55e"},

{name:"Kevin",chance:1/16,display:"1/16",color:"#eab308"},

{name:"Erik",chance:1/32,display:"1/32",color:"#a855f7"},

{name:"Sussy Kevin",chance:1/69,display:"1/69",color:"#14b8a6"},

{name:"Cayden",chance:1/75,display:"1/75",color:"#06b6d4"},

{name:"Silas",chance:1/150,display:"1/150",color:"#22d3ee"},

{name:"Nick",chance:1/165,display:"1/165",color:"#f97316"},

{name:"3 Ball Caleb",chance:1/100,display:"1/100",color:"#ec4899"},

{name:"Big Buff Erik",chance:1/200,display:"1/200",color:"#f43f5e"},

{name:"Derek",chance:1/300,display:"1/300",color:"#f472b6"},

{name:"Ginger Erik",chance:1/500,display:"1/500",color:"#ff8c00",ginger:true},

{name:"Easton",chance:1/750,display:"1/750",color:"#8b5cf6"},

{name:"Deku Nick",chance:1/1000,display:"1/1000",color:"#22c55e"}

];


/* ================================
   PLAYER DATA
================================ */

let inventory =
JSON.parse(localStorage.getItem("fr_inventory")) || [];

let discovered =
JSON.parse(localStorage.getItem("fr_discovered")) || [];

let autoDelete =
JSON.parse(localStorage.getItem("fr_autoDelete")) || [];

let luckPotions =
Number(localStorage.getItem("fr_luck")) || 0;

let speedPotions =
Number(localStorage.getItem("fr_speed")) || 0;

let rolls =
Number(localStorage.getItem("fr_rolls")) || 0;

let secondsPlayed =
Number(localStorage.getItem("fr_time")) || 0;

let gadgets =
JSON.parse(localStorage.getItem("fr_gadgets")) || {
calebRoller:false,
speed:false,
freshest:false
};

let equippedGadget =
localStorage.getItem("fr_equipped") || null;

let autoCraft =
localStorage.getItem("fr_autoCraft") || null;

let autoRoll =
localStorage.getItem("fr_autoRoll") === "true";

let luckActive=false;
let speedPotionActive=false;
let spinning=false;


/* ================================
   RECIPES
================================ */

const recipes={

calebRoller:{
Caleb:50
},

speed:{
Kevin:5,
Erik:3,
Cayden:1
},

freshest:{
Derek:1,
Caleb:1,
Ravar:1,
Silas:1,
Nick:1
}

};


/* ================================
   INVENTORY LIMIT
================================ */

function getInventoryLimit(){

if(rolls>=200)return 100;

if(rolls>=100)return 60;

if(rolls>=50)return 40;

return 20;

}


/* ================================
   SAVE
================================ */

function save(){

localStorage.setItem(
"fr_inventory",
JSON.stringify(inventory)
);

localStorage.setItem(
"fr_discovered",
JSON.stringify(discovered)
);

localStorage.setItem(
"fr_autoDelete",
JSON.stringify(autoDelete)
);

localStorage.setItem(
"fr_luck",
luckPotions
);

localStorage.setItem(
"fr_speed",
speedPotions
);

localStorage.setItem(
"fr_rolls",
rolls
);

localStorage.setItem(
"fr_time",
secondsPlayed
);

localStorage.setItem(
"fr_gadgets",
JSON.stringify(gadgets)
);

localStorage.setItem(
"fr_equipped",
equippedGadget || ""
);

localStorage.setItem(
"fr_autoCraft",
autoCraft || ""
);

localStorage.setItem(
"fr_autoRoll",
autoRoll
);

}


/* ================================
   COUNT AURA
================================ */

function countAura(name){

return inventory.filter(
aura=>aura.name===name
).length;

}


/* ================================
   RECIPE CHECK
================================ */

function hasRecipe(recipe){

for(const name in recipe){

if(
countAura(name)<recipe[name]
){

return false;

}

}

return true;

}


/* ================================
   REMOVE RECIPE
================================ */

function removeRecipe(recipe){

if(!hasRecipe(recipe))
return false;

for(const name in recipe){

let amount=recipe[name];

for(let i=0;i<amount;i++){

const index=
inventory.findIndex(
aura=>aura.name===name
);

if(index!==-1)
inventory.splice(index,1);

}

}

return true;

}


/* ================================
   CRAFT
================================ */

function craftGadget(type){

if(gadgets[type]){

showCraftMessage(
"You already own this gadget."
);

return;

}

if(!hasRecipe(recipes[type])){

showCraftMessage(
"❌ You don't have the required auras."
);

return;

}

removeRecipe(recipes[type]);

gadgets[type]=true;

save();

updateAll();

showCraftMessage(
"🛠️ Gadget crafted!"
);

}


/* ================================
   EQUIP
================================ */

function equipGadget(type){

if(!gadgets[type]){

showCraftMessage(
"Craft the gadget first."
);

return;

}

if(equippedGadget===type){

equippedGadget=null;

}else{

equippedGadget=type;

}

save();

updateAll();

}


/* ================================
   AUTO CRAFT
================================ */

function toggleAutoCraft(type){

if(!gadgets[type]){

showCraftMessage(
"Craft the gadget first."
);

return;

}

if(autoCraft===type){

autoCraft=null;

}else{

autoCraft=type;

}

save();

updateAll();

}


/*
 Auto-craft uses the aura only when
 the full recipe is available.

 Since the aura has already been added
 to inventory, the recipe is consumed
 normally.
*/

function processAutoCraft(){

if(!autoCraft)
return;

if(!gadgets[autoCraft])
return;

if(hasRecipe(recipes[autoCraft])){

removeRecipe(recipes[autoCraft]);

showCraftMessage(
"🛠️ AUTO-CRAFT COMPLETED!"
);

}

}


/* ================================
   RANDOM ROLL
================================ */

function getRandomAura(){

let globalLuck=1;


/*
 Every 10th roll is double luck.
*/

if(
rolls%10===0
){

globalLuck*=2;

}


/*
 Luck potion.
*/

if(luckActive){

globalLuck*=1.5;

}


/*
 Fresh Meat.
*/

if(
equippedGadget==="freshest"
){

globalLuck*=2;

}


/*
 Caleb Roller.
*/

let weights=[];

let total=0;

for(const aura of auras){

let weight=aura.chance;


/*
 General luck helps rarer auras more.
*/

if(globalLuck>1){

if(aura.chance<=1/32){

weight*=
1+
((globalLuck-1)*1.25);

}else{

weight*=
1+
((globalLuck-1)*.35);

}

}


/*
 Caleb Roller boosts Caleb-related
 names without guaranteeing them.
*/

if(
equippedGadget==="calebRoller"
){

if(aura.name==="Caleb")
weight*=2.5;

if(aura.name==="3 Ball Caleb")
weight*=1.8;

}


weights.push({
aura,
weight
});

total+=weight;

}


let random=
Math.random()*total;

for(const item of weights){

random-=item.weight;

if(random<=0)
return item.aura;

}

return auras[0];

}


/* ================================
   SPIN
================================ */

function spin(){

if(spinning)
return;

if(
inventory.length>=getInventoryLimit()
){

showMessage(
"🎒 Inventory full! Delete an aura first."
);

autoRoll=false;

save();

updateAll();

return;

}

spinning=true;

document.getElementById(
"spinButton"
).disabled=true;

rolls++;

const result=getRandomAura();

const name=
document.getElementById("auraName");

const chance=
document.getElementById("auraChance");

name.className="rolling";

let duration=1200;


/*
 1.75× speed gadget.
*/

if(
equippedGadget==="speed"
){

duration/=1.75;

}


/*
 Speed potion.
*/

if(speedPotionActive){

duration/=1.5;

}


let fake=setInterval(()=>{

const fakeAura=
auras[
Math.floor(
Math.random()*auras.length
)
];

if(
discovered.includes(
fakeAura.name
)
){

name.textContent=
fakeAura.name;

name.style.color=
fakeAura.color;

}else{

name.textContent="???";

name.style.color="#475569";

}

},70);


setTimeout(()=>{

clearInterval(fake);

name.className="";

const isNew=
!discovered.includes(
result.name
);

if(isNew){

discovered.push(
result.name
);

name.classList.add(
"newAura"
);

showMessage(
"✨ NEW AURA: "+
result.name+
"!"
);

}


name.textContent=result.name;

name.style.color=result.color;

chance.textContent=
"Chance: "+result.display;


/*
 Ginger Erik special animation.
*/

if(result.ginger){

name.classList.remove(
"newAura"
);

name.classList.add(
"ginger"
);

}


/*
 Auto delete.
*/

if(
autoDelete.includes(
result.name
)
){

showMessage(
"🗑️ "+
result.name+
" was auto-deleted."
);

}else{

inventory.push({

name:result.name,

color:result.color,

chance:result.display,

id:
Date.now()+
Math.random()

});

}


/*
 Auto-craft checks the inventory
 after this roll.
*/

processAutoCraft();

luckActive=false;

speedPotionActive=false;

save();

updateAll();

spinning=false;

document.getElementById(
"spinButton"
).disabled=false;


/*
 Continue auto roll.
*/

if(
autoRoll &&
inventory.length<
getInventoryLimit()
){

setTimeout(
spin,
250
);

}

},duration);

}


/* ================================
   POTIONS
================================ */

function useLuckPotion(){

if(luckPotions<=0){

showMessage(
"You don't have a Luck Potion."
);

return;

}

luckPotions--;

luckActive=true;

save();

updateAll();

showMessage(
"🍀 Luck activated for your next roll!"
);

}


function useSpeedPotion(){

if(speedPotions<=0){

showMessage(
"You don't have a Speed Potion."
);

return;

}

speedPotions--;

speedPotionActive=true;

save();

updateAll();

showMessage(
"⚡ Your next roll will be faster!"
);

}


/* ================================
   AUTO ROLL
================================ */

function toggleAutoRoll(){

if(rolls<75)
return;

autoRoll=!autoRoll;

save();

updateAll();

if(
autoRoll &&
!spinning
){

spin();

}

}


/* ================================
   DELETE
================================ */

function deleteAura(id){

inventory=
inventory.filter(
aura=>aura.id!==id
);

save();

updateAll();

}


/* ================================
   AUTO DELETE
================================ */

function toggleAutoDelete(name){

if(
autoDelete.includes(name)
){

autoDelete=
autoDelete.filter(
item=>item!==name
);

}else{

autoDelete.push(name);

}

save();

updateAll();

}


/* ================================
   PAGE
================================ */

function showPage(page,button){

document
.querySelectorAll(".page")
.forEach(
item=>
item.classList.remove("active")
);

document
.getElementById(page)
.classList.add("active");

document
.querySelectorAll(".tab")
.forEach(
item=>
item.classList.remove("active")
);

button.classList.add("active");

updateAll();

}


/* ================================
   INVENTORY UI
================================ */

function updateInventory(){

const box=
document.getElementById(
"inventoryList"
);

box.innerHTML="";

if(inventory.length===0){

box.innerHTML=
`<div class="empty">
Your inventory is empty.
</div>`;

return;

}

inventory.forEach(aura=>{

const item=
document.createElement("div");

item.className=
"inventoryItem";

item.innerHTML=`

<span
class="auraText"
style="color:${aura.color}">
${aura.name}
</span>

<span class="chance">
${aura.chance}
</span>

<button
class="delete"
onclick="deleteAura(${aura.id})">
DELETE
</button>

`;

box.appendChild(item);

});

}


/* ================================
   AUTO DELETE UI
================================ */

function updateAutoDelete(){

const box=
document.getElementById(
"autoDeleteList"
);

box.innerHTML="";

auras.forEach(aura=>{

const active=
autoDelete.includes(
aura.name
);

const known=
discovered.includes(
aura.name
);

const item=
document.createElement("div");

item.className="autoItem";

item.innerHTML=`

<span
style="
color:${known?aura.color:"#475569"};
font-weight:900;">
${known?aura.name:"???"}
</span>

<button
class="autoButton ${
active?"active":""
}"
onclick="toggleAutoDelete('${aura.name}')">

${
active
?"AUTO DELETE ON"
:"AUTO DELETE"
}

</button>

`;

box.appendChild(item);

});

}


/* ================================
   INDEX
================================ */

function updateIndex(){

const box=
document.getElementById(
"indexList"
);

box.innerHTML="";

auras.forEach(aura=>{

const known=
discovered.includes(
aura.name
);

const item=
document.createElement("div");

item.className=
"indexItem";

item.innerHTML=`

<span
class="auraText"
style="
color:${known?aura.color:"#475569"}">

${known?aura.name:"???"}

</span>

<span class="chance">

${known?aura.display:"???"}

</span>

<span>
${known?"✅":"🔒"}
</span>

`;

box.appendChild(item);

});

}


/* ================================
   RECIPE PROGRESS
================================ */

function recipeProgress(
recipe,
elementID
){

const box=
document.getElementById(
elementID
);

let text="";

for(const name in recipe){

const have=
countAura(name);

const needed=
recipe[name];

text+=
`${name}: ${Math.min(have,needed)}/${needed}<br>`;

}

box.innerHTML=text;

}


/* ================================
   CRAFT UI
================================ */

function updateCraft(){

recipeProgress(
recipes.calebRoller,
"calebProgress"
);

recipeProgress(
recipes.speed,
"speedProgress"
);

recipeProgress(
recipes.freshest,
"freshProgress"
);

updateGadgetButtons(
"calebRoller",
"equipCaleb",
"autoCaleb"
);

updateGadgetButtons(
"speed",
"equipSpeed",
"autoSpeed"
);

updateGadgetButtons(
"freshest",
"equipFreshest",
"autoFreshest"
);

}


/* ================================
   GADGET BUTTONS
================================ */

function updateGadgetButtons(
type,
equipID,
autoID
){

const equip=
document.getElementById(
equipID
);

const auto=
document.getElementById(
autoID
);

if(gadgets[type]){

equip.textContent=
equippedGadget===type
?"UNEQUIP"
:"EQUIP";

equip.classList.toggle(
"equipped",
equippedGadget===type
);

auto.textContent=
autoCraft===type
?"AUTO-CRAFT: ON"
:"AUTO-CRAFT: OFF";

auto.classList.toggle(
"active",
autoCraft===type
);

}else{

equip.textContent=
"CRAFT IT FIRST";

auto.textContent=
"CRAFT IT FIRST";

}

}


/* ================================
   EQUIPPED GADGET
================================ */

function updateEquipped(){

const box=
document.getElementById(
"equippedGadget"
);

if(!equippedGadget){

box.innerHTML=
`<span class="small">
No gadget equipped.
</span>`;

return;

}

if(
equippedGadget==="calebRoller"
){

box.innerHTML=
`<div class="equippedBanner">
🎰 CALEB ROLLER EQUIPPED
<br>
<span class="small">
Improved Caleb-related chances
</span>
</div>`;

}

if(
equippedGadget==="speed"
){

box.innerHTML=
`<div class="equippedBanner">
⚡ 1.75× SPEED EQUIPPED
<br>
<span class="small">
Roll speed increased
</span>
</div>`;

}

if(
equippedGadget==="freshest"
){

box.innerHTML=
`<div class="equippedBanner">
🥩 FRESH MEAT EQUIPPED
<br>
<span class="small">
2× Luck
</span>
</div>`;

}

}


/* ================================
   INVENTORY UPGRADE
================================ */

function updateUpgrade(){

const limit=
getInventoryLimit();

document.getElementById(
"inventoryCount"
).textContent=
inventory.length+
"/"+
limit;

const text=
document.getElementById(
"upgradeText"
);

const bar=
document.getElementById(
"upgradeProgress"
);

if(rolls<50){

text.textContent=
"🔒 40 slots at 50 rolls.";

bar.style.width=
(rolls/50*100)+"%";

}

else if(rolls<100){

text.textContent=
"🎒 40 slots unlocked! 60 slots at 100 rolls.";

bar.style.width=
((rolls-50)/50*100)+"%";

}

else if(rolls<200){

text.textContent=
"🎒 60 slots unlocked! 100 slots at 200 rolls.";

bar.style.width=
((rolls-100)/100*100)+"%";

}

else{

text.textContent=
"🏆 MAX INVENTORY: 100 SLOTS";

bar.style.width="100%";

}

}


/* ================================
   AUTO ROLL UI
================================ */

function updateAutoRoll(){

const button=
document.getElementById(
"autoRollButton"
);

const status=
document.getElementById(
"autoRollStatus"
);

if(rolls>=75){

button.disabled=false;

button.textContent=
autoRoll
?"AUTO ROLL: ON"
:"AUTO ROLL: OFF";

status.textContent=
autoRoll
?"🤖 Auto Roll is active."
:"✅ Auto Roll unlocked.";

}else{

button.disabled=true;

button.textContent=
"AUTO ROLL: LOCKED";

status.textContent=
"🔒 Unlocks at 75 rolls. "+
(75-rolls)+
" more to go.";

}

}


/* ================================
   MESSAGES
================================ */

function showCraftMessage(text){

document.getElementById(
"craftMessage"
).textContent=text;

}

function showMessage(text){

document.getElementById(
"message"
).textContent=text;

}


/* ================================
   UPDATE EVERYTHING
================================ */

function updateAll(){

document.getElementById(
"rollCount"
).textContent=rolls;

document.getElementById(
"luckPotions"
).textContent=luckPotions;

document.getElementById(
"speedPotions"
).textContent=speedPotions;

const minutes=
Math.floor(
secondsPlayed/60
);

const seconds=
secondsPlayed%60;

document.getElementById(
"playTime"
).textContent=
minutes+
":"+
String(seconds).padStart(2,"0");

updateInventory();

updateAutoDelete();

updateIndex();

updateCraft();

updateEquipped();

updateUpgrade();

updateAutoRoll();

}


/* ================================
   PLAY TIME / POTIONS
================================ */

setInterval(()=>{

secondsPlayed++;


/*
 Every 2 minutes
*/

if(
secondsPlayed%120===0
){

luckPotions++;

showMessage(
"🍀 You earned a Luck Potion!"
);

}


/*
 Every 3 minutes
*/

if(
secondsPlayed%180===0
){

speedPotions++;

showMessage(
"⚡ You earned a Speed Potion!"
);

}

save();

updateAll();

},1000);


/* ================================
   START
================================ */

updateAll();

</script>

</body>
</html>
